# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/thegathering

# Security Configuration
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=300

# Application Configuration
APP_NAME=The Gathering API
DEBUG=true

# API Keys
DEEPL_API_KEY=your-deepl-api-key
OPENAI_API_KEY=your-openai-api-key        # optional if GOOGLE_API_KEY is set
GOOGLE_API_KEY=your-google-api-key        # optional if OPENAI_API_KEY is set

# Redis
REDIS_URL=redis://localhost:6379

# AI Feature Flags
AI_FEATURES_ENABLED=true
AI_AGENT_MODE_ENABLED=false               # Master-switch: enables agent mode globally (per-entity toggle still required)

# RAG & Vector Search Configuration
ENABLE_VECTOR_SEARCH=true
EMBEDDING_PROVIDER=google                 # google | openai
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
VECTOR_SEARCH_WEIGHT=0.7
KEYWORD_SEARCH_WEIGHT=0.3

# Keyword Extraction Configuration (YAKE)
KEYWORD_LANGUAGE=de                       # de | en
KEYWORD_MAX_NGRAMS=3
KEYWORD_WINDOW_SIZE=3
KEYWORD_DEDUP_THRESHOLD=0.9
KEYWORD_MIN_LENGTH=2
KEYWORD_TOP_N=20

# Memory Retrieval Limits
TOTAL_MEMORY_LIMIT=7
GUARANTEED_SHORT_TERM=1
GUARANTEED_LONG_TERM=0
GUARANTEED_PERSONALITY=0

# Layer Weights for Cross-Layer RRF
SHORT_TERM_WEIGHT=2.0
LONG_TERM_WEIGHT=1.0
PERSONALITY_WEIGHT=1.0

# Retrieval Candidate Limits per Layer
SHORT_TERM_CANDIDATES=5
LONG_TERM_CANDIDATES=5
PERSONALITY_CANDIDATES=5

# TTL for Short-term Memories
SHORT_TERM_TTL_DAYS=7

# Long-Term Memory Configuration
LTM_PROVIDER=google                       # google | openai
LTM_EXTRACTION_MODEL=gemini-2.5-flash-lite
LTM_EXTRACTION_TEMPERATURE=0.3
LTM_MAX_FACTS_PER_CHUNK=10
LTM_MIN_IMPORTANCE_THRESHOLD=5.0
LTM_EXTRACTION_MAX_RETRIES=3
LTM_EXTRACTION_RETRY_DELAY=1.0

# RRF (Reciprocal Rank Fusion)
RRF_CONSTANT_K=60
